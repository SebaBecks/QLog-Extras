      <widget class="QLabel" name="gainCaption">
       <property name="text"><string>S9+</string></property>
      </widget>
     </item>
     <item>
      <widget class="QDoubleSpinBox" name="gainSpinBox">
       <property name="toolTip"><string>Slope correction above S9. Hamlib reads the rig's raw meter and converts it on a scale of its own, which on some rigs runs flatter above S9 than the rig's own face does - so the stronger the signal, the wider the gap. Set this until a strong station reads the same here as on the rig. One means no correction.</string></property>
       <property name="prefix"><string>x </string></property>
       <property name="decimals"><number>1</number></property>
       <property name="singleStep"><double>0.1</double></property>
       <property name="minimum"><double>1.0</double></property>
       <property name="maximum"><double>5.0</double></property>
       <property name="value"><double>1.0</double></property>
      </widget>
     </item>
