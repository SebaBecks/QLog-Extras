     <item>
      <widget class="QSpinBox" name="calSpinBox">
       <property name="toolTip"><string>Correction applied to the strength reading. The calibration table Hamlib holds for a rig can sit a little off the rig's own meter; six decibels is one S unit.</string></property>
       <property name="suffix"><string> dB</string></property>
       <property name="minimum"><number>-30</number></property>
       <property name="maximum"><number>30</number></property>
      </widget>
